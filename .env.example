# 本机/本容器的环境特定配置模板。
#
# 用法：复制为项目根的 .env（该文件已被 .gitignore 忽略，不会进版本库）后按需填写。
#   cp .env.example .env
#
# tools/worktree.sh 会在跑构建门禁/init 前读取它，只认下面这些代理与工具链键，
# 其余内容忽略（文件存在但不可读会 fail-closed 并提示修正权限，不会静默降级）。
# 未创建 .env 或 DSH_PROXY_ENABLED 不为 1 时：完全不设置任何代理。

# 代理总开关：1 启用，0 或缺省 = 不设代理（离线/直连环境保持默认即可）。
DSH_PROXY_ENABLED=1

# HTTP(S) 代理，形如 http://192.168.1.2:8080
# 启用后同时导出 HTTP_PROXY / HTTPS_PROXY（含小写形式）。
# DSH_PROXY_HTTP=

# SOCKS5 代理，形如 socks5://192.168.1.2:1088
# 启用后导出 ALL_PROXY，并为 Gradle/JVM 拆成 -DsocksProxyHost/-DsocksProxyPort
# （JVM 不认 ALL_PROXY）。
# DSH_PROXY_SOCKS=

# ── 工具链路径（可选）────────────────────────────────────────────
# 不填则回退到脚本内置约定值 /home/mark/sdk/{flutter,jdk17,android}；
# 环境里已存在同名变量时优先于 .env（默认值 < .env < 进程环境）。
# PATH 只追加缺失项，重复 apply 不会累积。
# DSH_FLUTTER_SDK=/home/mark/sdk/flutter
# DSH_JAVA_HOME=/home/mark/sdk/jdk17
# DSH_ANDROID_HOME=/home/mark/sdk/android
# DSH_PUB_CACHE=/home/mark/.pub-cache
# DSH_GRADLE_USER_HOME=/home/mark/.gradle
